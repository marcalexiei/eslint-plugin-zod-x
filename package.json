{
  "name": "eslint-zod",
  "private": true,
  "license": "MIT",
  "author": "Marco Pasqualetti @marcalexiei",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/eslint-zod"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "pnpm run lint:js && pnpm run lint:docs && pnpm run lint:knip",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:docs": "pnpm -r lint:docs",
    "lint:knip": "knip",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm -r test",
    "release": "pnpm run build && changeset publish",
    "check-all": "pnpm run format && pnpm run build && pnpm run lint && pnpm run test && pnpm run typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@marcalexiei/eslint-config": "7.0.0",
    "@marcalexiei/prettier-config": "catalog:dev",
    "@types/node": "25.8.0",
    "@vitest/eslint-plugin": "1.6.18",
    "eslint": "10.4.1",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-eslint-plugin": "7.3.3",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-n": "18.0.1",
    "knip": "6.14.2",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "prettier": "@marcalexiei/prettier-config",
  "engines": {
    "node": "^20 || ^22 || >=24"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
